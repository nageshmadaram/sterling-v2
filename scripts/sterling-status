#!/usr/bin/env bash
# One screen that says whether Sterling is safe to run today.
#
# Written for someone who does not read code. Every line is either a fact or a
# plain-language instruction. If anything says BLOCKED, Sterling will not open
# new positions, and the reason is printed underneath.
set -uo pipefail

STERLING_ROOT="${STERLING_ROOT:-$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)}"
PYTHON="${STERLING_PYTHON:-$STERLING_ROOT/backend/.venv/bin/python}"
export STERLING_ROOT
export STERLING_SAFE_MODE_FILE="${STERLING_SAFE_MODE_FILE:-$STERLING_ROOT/data/safe_mode.json}"
export STERLING_HEALTH_URL="${STERLING_HEALTH_URL:-http://127.0.0.1:8000}"

"$PYTHON" - <<'PY'
import json, os, subprocess, sys, urllib.error, urllib.request
from datetime import date
from pathlib import Path

root = Path(os.environ["STERLING_ROOT"])
sys.path.insert(0, str(root / "backend"))

def line(label, value, note=""):
    print(f"{label:<22}{value}" + (f"   {note}" if note else ""))

def head(text):
    print()
    print(text)

print("STERLING STATUS")
print()

# ─── identity ────────────────────────────────────────────────────────────────
try:
    sha = subprocess.check_output(["git", "-C", str(root), "rev-parse", "HEAD"], text=True).strip()
    tag = subprocess.run(["git", "-C", str(root), "describe", "--tags", "--exact-match"],
                         capture_output=True, text=True).stdout.strip()
except Exception:
    sha, tag = "unknown", ""
line("Build", sha[:12])
line("Release", tag or "(between releases)")

# ─── safety switch ───────────────────────────────────────────────────────────
from app.services.safe_mode import SafeModeService

safe = SafeModeService(os.environ["STERLING_SAFE_MODE_FILE"]).read()
head("SAFETY")
line("Safe mode", "ON" if safe.active else "OFF")
line("New trades", "BLOCKED by safe mode" if safe.active else "not blocked by safe mode", "see BOTTOM LINE")
line("Closing trades", "always allowed")
if safe.active:
    line("Because", safe.reason or "no reason recorded")
    line("Conditions", ", ".join(safe.triggers) or "none recorded")

# ─── the service ─────────────────────────────────────────────────────────────
head("SERVICE")
try:
    url = f"{os.environ['STERLING_HEALTH_URL']}/api/v1/health/ready"
    try:
        with urllib.request.urlopen(url, timeout=3) as fh:
            payload = json.loads(fh.read())
    except urllib.error.HTTPError as exc:
        # A 503 here is Sterling refusing to start, and the body says why.
        payload = json.loads(exc.read())
    line("Backend", "RUNNING")
    # /health/ready is the Snapback evidence recorder's readiness. It needs the
    # frozen experiment config; live entries are gated by safe mode, the
    # control plane and the doctor, not by this line.
    line("Snapback recorder", payload.get("status", "unknown"), "research only; does not gate live trades")
    failed = payload.get("failed_checks") or []
    if failed:
        line("Recorder waits on", ", ".join(failed))
        for check in payload.get("checks", []):
            if check.get("code") in failed:
                detail = check.get("details")
                if isinstance(detail, list) and detail:
                    line("", str(detail[0])[:60])
except Exception:
    line("Backend", "NOT RUNNING", "start it before trading")

# ─── the lake ────────────────────────────────────────────────────────────────
head("DATA")
try:
    from kitelake.volume import resolve_root
    lake = Path(resolve_root())
    line("Lake", "MOUNTED" if lake.exists() else "MISSING", str(lake))
except Exception as exc:
    lake = None
    line("Lake", "MISSING", f"{type(exc).__name__}: plug in the drive")

# ─── today's evidence ────────────────────────────────────────────────────────
head("EVIDENCE TODAY")
if lake and lake.exists():
    try:
        from study.snapback_evidence_audit import audit_date
        sys.path.insert(0, str(root / "backend"))
        report = audit_date(lake, date.today())
        line("Opportunities", report["opportunities"])
        line("Listed", report["selection"]["LISTED"])
        line("Not listed", report["selection"]["NOT_LISTED"])
        line("Unknown", report["selection"]["UNKNOWN"])
        line("Blocked", report["blocked"])
        line("Authoritative", report["economic_authoritative"])
        line("Inconclusive", report["inconclusive"])
    except Exception as exc:
        line("Evidence", "UNREADABLE", f"{type(exc).__name__}")
else:
    line("Evidence", "UNAVAILABLE", "the lake is not mounted")

# ─── urls & tunnels ──────────────────────────────────────────────────────────
head("URLS & TUNNELS")
try:
    status_file = root / ".runtime" / "stack" / "status.json"
    if status_file.exists():
        state = json.loads(status_file.read_text())
        mode = state.get("mode", "unknown")
        line("Mode", mode)
        line("Local gateway", state.get("local_url", ""))
        if state.get("dev_url"):
            line("Dev hot-reload", state["dev_url"])
        if mode != "local":
            cf_url = (state.get("urls") or {}).get("cloudflare", "")
            cf_ready = (state.get("public_ready") or {}).get("cloudflare", False)
            if cf_url:
                line("Cloudflare", cf_url, "VERIFIED" if cf_ready else "unverified")
            elif state.get("cloudflare_url", "").startswith("https://"):
                line("Cloudflare", state["cloudflare_url"], "unverified")
            else:
                line("Cloudflare", "not discovered yet")
        if state.get("callback_url"):
            line("Kite callback", state["callback_url"])
        if state.get("mini_app_url"):
            line("Telegram desk", state["mini_app_url"])
        if state.get("telegram_menu_updated"):
            line("Telegram menu", "set")
    else:
        line("Stack manager", "NOT RUNNING", "use ./sterling.sh up")
except Exception as exc:
    line("Stack status", "UNREADABLE", f"{type(exc).__name__}")


# ─── the bottom line ─────────────────────────────────────────────────────────
head("BOTTOM LINE")
# The real admission answer, the same one every new order is checked against.
try:
    from app.core.runtime_env import load_sterling_env
    from app.services.live_runtime import live_status

    # Read the same backend/.env the service loads; without it the kill
    # switch reads as unset here and the line contradicts the running service.
    load_sterling_env()

    status = live_status()
    admission = status["admission"]
    blockers = sorted({b for a in admission["accounts"] for b in a["blockers"]})
    # The supervisor's admission does not include the STERLING_LIVE_EXECUTION
    # kill switch; execution_service enforces it on every entry order.
    execution = status.get("live_execution") or {}
    if not execution.get("enabled"):
        blockers.append("live_execution_off (STERLING_LIVE_EXECUTION)")
    if admission["may_open_new_exposure"] and execution.get("enabled"):
        line("New entries", "OPEN", "real money; exits always allowed")
    else:
        line("New entries", "BLOCKED", ", ".join(blockers) or "reason unknown")
        if "safe_mode" in blockers:
            line("", "Run: ./scripts/sterling-safe-mode status")
except Exception as exc:
    line("New entries", "UNKNOWN", f"could not read admission ({type(exc).__name__})")
print()
print("Evidence              Snapback is not yet proven on real trades")
print("                      (needs 300+ trades across 60+ sessions).")
print("                      Informational: this does not block entries.")
PY
