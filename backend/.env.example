ENVIRONMENT=development
REAL_PUBLIC_DATA=true
DEFAULT_UNDERLYING=NIFTY
EXCHANGE_ADAPTER=zerodha
LOG_LEVEL=INFO
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]
MAX_CONTRACTS=10
MAX_POSITION_PCT=0.05
DEFAULT_CAPITAL=100000.0
# Exchange credentials (optional — public data works without keys)
DELTA_API_KEY=
DELTA_API_SECRET=

# Zerodha Kite (optional — used by add_kite.py / Kite integration)
# Set these and the backend provisions the Kite account at boot, so a fresh DB or
# a new machine never needs credentials retyped into the UI.
KITE_API_KEY=
KITE_API_SECRET=
# Aliases accepted by add_kite.py and by the boot-time seeding:
# ZERODHA_API_KEY=
# ZERODHA_API_SECRET=
#
# Optional: skip the interactive login entirely on a dev restart. Paste the
# access_token from one browser login and the process comes up connected.
# Zerodha invalidates every token at 06:00 IST, so this value goes stale daily —
# it is only ever adopted when the stored token is absent or already past its
# window, so a login done through the browser today is never overwritten by it.
# KITE_ACCESS_TOKEN=
#
# Which app user the seeded account belongs to, and how it presents itself.
# KITE_APP_USER_ID=default
# KITE_LABEL=Kite (env)
# Every account Sterling creates is a LIVE account. It stays unconnected until you
# complete a real Kite login (or set KITE_USER_ID alongside KITE_ACCESS_TOKEN);
# that login binds the account to your Zerodha identity.

# Live execution kill switch. Explicit true = Sterling originates new entries for
# Supertrend, Snapback and Gamma Unwind. 0/false/off/no/disabled stops every new
# entry (exits, protection and reconciliation keep working). Anything that is not
# a recognised value also stops entries. Restart the backend after changing it.
STERLING_LIVE_EXECUTION=false

# Production identity and security. These may remain blank in development, but
# ENVIRONMENT=production fails closed unless the security values are configured.
# Generate SECRET_KEY and JWT_SECRET independently (>=32 random characters each).
STERLING_SECRET_KEY=
STERLING_JWT_SECRET=
STERLING_ADMIN_USERNAME=admin
STERLING_ADMIN_PASSWORD=
#
# Stable deployment identity used by the broker-account binding. Do not reuse one
# state root from a different deployment id.
STERLING_DEPLOYMENT_ID=
#
# Public static outbound IP registered with Zerodha for API order placement.
# Record what this host actually uses with:
#   scripts/sterlingctl egress record <PUBLIC_STATIC_IP> [ROUTER_GENERATION]
# Production entries are refused until the latest observation matches this value.
STERLING_STATIC_EGRESS_IP=

# Optional day-one caps. Blank = not set. Recommended for the first session:
# one lot per entry and a rupee loss budget you can live with.
STERLING_LIVE_MINIMUM_MAX_LOTS=1
# STERLING_LIVE_MINIMUM_DAILY_LOSS_INR=1500
# STERLING_LIVE_MINIMUM_GROSS_EXPOSURE_INR=

# Main database. The file name predates this release; keep it so existing state
# (accounts, journal, positions) is found.
STERLING_DB_PATH=sterling_paper.db

# Unified Cloudflare-only public launcher; one backend and gateway.
# Keep tunnel tokens private and never commit them.
# STERLING_TUNNEL_PROVIDER=cloudflare
# STERLING_CLOUDFLARE_HOSTNAME=
# STERLING_CLOUDFLARE_TUNNEL_TOKEN=
# STERLING_DEV_FRONTEND=1
# Public/local app 5180 and Cloudflare are built only from a Git commit.
# Vite dev 5174 alone uses uncommitted frontend files.
# Default for the NEW supervisor: automatic reviewed origin/main frontend
# publication every ~60s, without checkout/merge, backend restart or tunnel churn:
# STERLING_PUBLISH_REF=origin/main
# STERLING_PUBLISH_FETCH=1
# Explicit opt-out / pin to committed local main instead:
# STERLING_PUBLISH_REF=main
# STERLING_PUBLISH_FETCH=0
# Older RUNNING supervisors need one-time environment + presentation restart
# to pick up remote auto-publication; changing GitHub alone is not bootstrap.

# Phase 1 — Trading mode
STERLING_DEFAULT_MODE=swing

# Phase 5 — Telegram notifications
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Phase 6 — Circuit breakers
STERLING_DAILY_LOSS_LIMIT=0.05
STERLING_MARGIN_FLOOR=0.20
STERLING_MAX_CONSECUTIVE_LOSSES=5

# v3 — Drawdown circuit breaker
STERLING_DD_WARN=0.05
STERLING_DD_HALT=0.10
STERLING_DD_RESET=0.15

# v3 — Correlation penalty thresholds
STERLING_CORR_PENALTY_HIGH=0.8
STERLING_CORR_PENALTY_MED=0.6

# v3 — Walk-forward engine defaults
STERLING_WF_TRAIN_BARS=180
STERLING_WF_TEST_BARS=60

# v3 — Sensitivity analysis
STERLING_SENSITIVITY_STALE_DAYS=7

# Snapback prospective evidence database (absolute path recommended)
STERLING_OBSERVATIONS_DB_PATH=data/snapback/prospective_freeze_1.db
# Runtime SHA is discovered from Git HEAD; do not declare it in the environment.
STERLING_SNAPBACK_BACKUP_ROOT=backups/snapback
STERLING_FORWARD_REPORT_ROOT=artifacts/snapback_forward
STERLING_POST_MARKET_STATE_PATH=data/snapback/post_market_ops_state.json
STERLING_FREEZE_RECORD_PATH=docs/strategy/snapback/PROSPECTIVE_FREEZE_RECORD.md
STERLING_NEW_TRADES_HALT_PATH=data/snapback/new_trades_halt.json
# Account binding used by Snapback reconciliation and broker-binding checks: the
# Sterling user and Kite account id the runtime reconciles against. All three
# strategies run; STERLING_FAMILY_MODE is retired (leave it unset).
STERLING_FAMILY_USER_ID=
STERLING_FAMILY_ACCOUNT_ID=
