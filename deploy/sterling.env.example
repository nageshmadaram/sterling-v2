# Sterling — deployment environment file (TEMPLATE)
#
# Copy this to a path OUTSIDE the repository and fill it in:
#
#   mkdir -p ~/.config/sterling
#   install -m 600 deploy/sterling.env.example ~/.config/sterling/sterling.env
#   ${EDITOR:-nano} ~/.config/sterling/sterling.env
#
# Mode 600 matters: this file holds the Kite API secret. It is read by the
# systemd unit's EnvironmentFile= directive. NEVER commit a filled-in copy.
#
# WHAT THIS FILE CANNOT DO
# Zerodha requires a human at the TOTP/2FA step every trading day. Perform the
# Kite login yourself before the market session; this file cannot automate it.

# ── Production identity + secrets ───────────────────────────────────────────
ENVIRONMENT=production

# Generate THREE independent values. Never reuse one value for another purpose:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
STERLING_SECRET_KEY=<generate one; see above>
STERLING_JWT_SECRET=<generate a different one>

# First-party Sterling login. On a fresh production database startup refuses to
# create a passwordless admin. The bootstrap admin keeps id="default" so existing
# account/evidence ownership does not change when authentication is enabled.
STERLING_ADMIN_USERNAME=admin
STERLING_ADMIN_PASSWORD=<generate a strong operator password, 12+ characters>

# ── Kite (Zerodha) ───────────────────────────────────────────────────────────
KITE_API_KEY=<your kite api key>
KITE_API_SECRET=<your kite api secret>
KITE_APP_USER_ID=default
KITE_LABEL=Sterling

# Every Kite account Sterling creates is a LIVE account bound to the Zerodha
# identity that completes the login. Leave KITE_ACCESS_TOKEN blank and log in from
# the Sterling UI each trading day (Zerodha tokens expire at 06:00 IST). If you do
# paste a token, also set KITE_USER_ID so the token can be bound to its owner.
# Accounts are always live; a leftover KITE_* mode flag from an old file is ignored.
KITE_ACCESS_TOKEN=
# KITE_USER_ID=

# ── Live execution ───────────────────────────────────────────────────────────
# Sterling runs Supertrend, Snapback and Gamma Unwind with real orders.
# This is the operator KILL SWITCH for NEW entries:
#   true (or unset)                    entries are on
#   0 | false | off | no | disabled    no new entry originates, anywhere
# Exits, protective stops and reconciliation keep working when it is off. An
# unrecognised value also turns entries off. Restart the service to apply a change.
STERLING_LIVE_EXECUTION=true

# Day-one caps (optional; blank = not set). For the first session start with one
# lot per entry and a rupee loss budget you can accept. The daily-loss halt still
# applies on top (soft -1,000, hard -1,500 INR per account unless you changed it).
STERLING_LIVE_MINIMUM_MAX_LOTS=1
# STERLING_LIVE_MINIMUM_DAILY_LOSS_INR=1500
# STERLING_LIVE_MINIMUM_GROSS_EXPOSURE_INR=
# STERLING_LIVE_MINIMUM_MAX_DEPLOYED_PCT=100

# ── Deployment identity ──────────────────────────────────────────────────────
# Stable name for THIS installation. It must match the broker binding recorded
# for this machine; changing it creates a different deployment identity.
STERLING_DEPLOYMENT_ID=<stable deployment id, e.g. home-prod-1>

# This is an expectation, never the source of truth. A host checkout proves its
# executable identity from Git; a production image proves it from the
# content-verified build metadata baked into the image. A mismatch is reported.
STERLING_EXPECTED_BUILD_SHA=<full 40-character release SHA>

# Docker builders additionally receive STERLING_BUILD_SHA / STERLING_BUILD_TAG
# as build args. Runtime environment variables cannot redefine the actual SHA.
# The historical Snapback strategy identity remains frozen separately in code.

# Snapback records every scan decision under one explicit identity so its
# performance records stay attributable. Keep the same value from day to day
# unless you deliberately start a new record set.
STERLING_EXPERIMENT_ID=prospective_runtime_1_6
STERLING_ALLOCATION_CAPITAL_INR=1000000

# First market session whose Snapback records count toward its performance
# report. Use an explicit timezone. Earlier rows stay as history.
STERLING_DATASET_START=<first session to count, e.g. 2026-10-06T00:00:00+05:30>

# ── Persistent state ─────────────────────────────────────────────────────────
# Runtime and sterlingctl MUST resolve the same durable stores. For a fresh host
# install the repository root is the state root shown here. On an EXISTING
# install, do not point these at a new empty directory: take a verified backup,
# migrate the existing stores, then change the paths as one maintenance action.
STERLING_STATE_ROOT=/home/<user>/Sterling
# Main database. The file name predates this release; keep it so existing
# accounts, journal and positions are found.
STERLING_DB_PATH=/home/<user>/Sterling/data/sterling_paper.db
STERLING_OBSERVATIONS_DB_PATH=/home/<user>/Sterling/data/snapback/prospective_runtime_1_6.db
STERLING_EVIDENCE_DB=/home/<user>/Sterling/data/snapback/prospective_runtime_1_6.db
STERLING_INTENT_DB=/home/<user>/Sterling/data/intents.db
STERLING_SAFE_MODE_FILE=/home/<user>/Sterling/data/safe_mode.json
STERLING_BACKUP_ROOT=/home/<user>/Sterling/data/backups/snapback
STERLING_SNAPBACK_BACKUP_ROOT=/home/<user>/Sterling/data/backups/snapback
STERLING_BACKUP_DIR=/home/<user>/Sterling/data/backups/snapback

# Other durable evidence/state remains under this same installation root.
STERLING_FORWARD_REPORT_ROOT=/home/<user>/Sterling/artifacts/snapback_forward
STERLING_POST_MARKET_STATE_PATH=/home/<user>/Sterling/data/snapback/post_market_ops_state.json
STERLING_FREEZE_RECORD_PATH=docs/strategy/snapback/PROSPECTIVE_FREEZE_RECORD.md
STERLING_NEW_TRADES_HALT_PATH=/home/<user>/Sterling/data/snapback/new_trades_halted.json

# ── Account binding ──────────────────────────────────────────────────────────
# The Sterling user and Kite account id that reconciliation and the broker-binding
# check use. All three strategies run (Supertrend, Snapback, Gamma Unwind);
# STERLING_FAMILY_MODE is retired, leave it unset. The Adaptive Edge, Intraday,
# Opening Volume and Navigator strategies are maintenance-only: they manage and
# exit positions they already hold and never open new ones.
STERLING_FAMILY_USER_ID=<sterling user id>
STERLING_FAMILY_ACCOUNT_ID=<kite account id, e.g. KITE-XXXXXXXX>

# ── Network / broker egress ─────────────────────────────────────────────────
# Loopback only. Do not expose the broker session to the LAN even though the API
# now also requires Sterling JWT authentication in production.
STERLING_BIND_HOST=127.0.0.1

# Public static address registered with Kite for API order placement. Record the
# actual host observation with: ./scripts/sterlingctl egress record <ip>
STERLING_STATIC_EGRESS_IP=<broker-whitelisted public IP>

# ── Alerts (optional) ────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── Preflight thresholds (optional) ─────────────────────────────────────────
# STERLING_MIN_FREE_DISK_BYTES=2147483648
# STERLING_SKIP_CLOCK_CHECK=
